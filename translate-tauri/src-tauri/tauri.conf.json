{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Translate",
  "version": "1.0.0",
  "identifier": "com.translate.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Dịch nhanh",
        "width": 960,
        "height": 600,
        "minWidth": 260,
        "minHeight": 150,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true
      },
      {
        "label": "snip",
        "url": "snip.html",
        "title": "Chụp vùng màn hình",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
